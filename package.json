{
  "name": "building-materials-store",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:staff": "npm run dev --workspace=apps/staff",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:staff": "npm run build --workspace=apps/staff",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "build:site": "npm run build:web && npm run build:staff && node scripts/assemble-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:seed": "node scripts/demo/seed-demo.mjs",
    "demo:images": "node scripts/demo/seed-images.mjs"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
