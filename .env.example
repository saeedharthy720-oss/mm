# Root reference of every env var used across the monorepo.
# Actual apps read from their own .env files:
#   apps/api/.env    apps/web/.env    apps/staff/.env
# Copy each apps/*/.env.example to apps/*/.env and fill in values.

# --- apps/api ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bms:bms_dev_password@localhost:5432/building_materials_store

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Stage 4 — optional at Stage 1 boot
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1

# Stage 5 — frontend-only, no backend secret needed
WHATSAPP_STORE_NUMBER=+968XXXXXXXX

# File/media storage (see docs/architecture/decisions.md)
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=me-south-1
STORAGE_S3_BUCKET=building-materials-store-media
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_LOCAL_UPLOAD_DIR=./uploads

# --- apps/web and apps/staff (Vite — only VITE_-prefixed vars reach the browser) ---
VITE_API_BASE_URL=http://localhost:4000
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEFAULT_LANGUAGE=en
