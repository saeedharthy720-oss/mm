NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bms:bms_dev_password@localhost:5432/building_materials_store
# Unpooled connection, used only for migrations. Locally this is the same as
# DATABASE_URL; on Neon it's the connection string without "-pooler" in the host.
DIRECT_URL=postgresql://bms:bms_dev_password@localhost:5432/building_materials_store

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Stage 4 — optional at Stage 1 boot
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1

# Stage 5 — frontend-only, no backend secret needed
WHATSAPP_STORE_NUMBER=+968XXXXXXXX

# File/media storage
# "local" writes to disk (fine for dev); "s3" targets any S3-compatible service.
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOAD_DIR=./uploads

# Only needed when STORAGE_PROVIDER=s3. Example values are for Supabase Storage.
# https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_BUCKET=bms-media
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_S3_PUBLIC_BASE_URL=
# Supabase/MinIO/R2 need path-style addressing; set false only for real AWS S3.
STORAGE_S3_FORCE_PATH_STYLE=true
