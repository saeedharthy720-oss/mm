NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bms:bms_dev_password@localhost:5432/building_materials_store

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Stage 4 — optional at Stage 1 boot
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1

# Stage 5 — frontend-only, no backend secret needed
WHATSAPP_STORE_NUMBER=+968XXXXXXXX

# File/media storage
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=me-south-1
STORAGE_S3_BUCKET=building-materials-store-media
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_LOCAL_UPLOAD_DIR=./uploads
